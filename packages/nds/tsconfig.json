{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"],
  // Referenced by file rather than by directory, for the reason
  // `packages/demotic/tsconfig.json` records: Playwright's tsconfig loader
  // walks these when a spec imports this package, and it resolves a bare
  // directory to `<dir>.json`.
  "references": [{ "path": "../core/tsconfig.json" }, { "path": "../gba/tsconfig.json" }]
}
