-- Pong. Nothing here names a console: `1 cell` is
-- absolute, `15vw` is 15% of the playfield.

start title
seed 20260726

-- title ---------------------------------------

scene title

backdrop pong.title.svg

create text prompt in title (x centerx - 7, y screenheight - 2, text "press a to play")

when a pressed in title then scene as play

-- play ----------------------------------------

scene play

backdrop pong.play.svg
music rally.mid in play

sound bounce.wav on ball hits paddle
sound point.wav on ball hits screentop, screenbottom

create object ball (width 1 cell, height 1 cell, speed 55vmin, sprite ball.svg)
create object paddle (width 15vw, height 1 cell, speed 60vw, sprite paddle.svg)

create ball ball1 in play (x centerx, y centery, direction southwest)
create paddle paddle1 in play (x centerx, y screenheight - 1)
create paddle paddle2 in play (x centerx, y 0, speed 32vw)

-- How far off the ball the opponent aims. A number
-- with `visible 0` is how a game holds a value.
create number aim in play (value 0, visible 0)

create text you in play (x 1, y 1, text "you:")
create number score1 in play (value 0, x 6, y 1)
create text cpu in play (x screenwidth - 7, y 1, text "cpu:")
create number score2 in play (value 0, x screenwidth - 2, y 1)

control paddle1 left (xdirection -1) on hold
control paddle1 right (xdirection 1) on hold

-- The opponent, in one line: proportional, so it
-- eases in and stops on target instead of buzzing.
when always in play then paddle2.xdirection as clamp((ball1.centerx + aim.value - paddle2.centerx) / 5vw, -1, 1)

when ball hits screenleft, screenright then xdirection as flip
when paddle hits screenleft, screenright then xdirection as 0

-- The bounce angle comes out of where on the paddle
-- the ball landed, and every contact redraws `aim`.
when ball hits paddle then (ydirection, xdirection, aim.value) as (flip, (ball.centerx - paddle.centerx) / paddle.width, random(-9, 9) * 1vw)

when ball hits screentop then (score1.value, ball1.x, ball1.y, ball1.ydirection, aim.value) as (score1.value + 1, centerx, centery, 1, random(-9, 9) * 1vw)
when ball hits screenbottom then (score2.value, ball1.x, ball1.y, ball1.ydirection, aim.value) as (score2.value + 1, centerx, centery, -1, random(-9, 9) * 1vw)

when score1.value reaches 10 in play then scene as gameover
when score2.value reaches 10 in play then scene as gameover

-- game over -----------------------------------

scene gameover

create text result in gameover (x centerx - 4, y centery, text "game over")

when a pressed in gameover then scene as play
