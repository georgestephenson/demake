-- Runner. A course composed from chunks at build time,
-- and the seeded generator.

start title
seed 20260725

-- title ---------------------------------------

scene title

backdrop runner.title.svg

create text prompt in title (x centerx - 7, y screenheight - 2, text "press a to play")

when a pressed in title then scene as play

-- play ----------------------------------------

scene play

-- 24 chunks of 6 cells: a 144-cell course, drawn from
-- the seed at build time, never as the game runs.
stream course from open.dmtl, lowpipe.dmtl, highpipe.dmtl, pipemid.dmtl 24 wide

music updraft.mid in play
sound flap.wav on a pressed in play
sound coin.wav on bird1 hits prize
sound crash.wav on bird1 hits pipe, ground

camera follows bird1

-- Absolute speed: the course is 144 cells everywhere,
-- so a relative one would be a different game per console.
create object bird (width 1 cell, height 1 cell, speed 6, sprite bird.svg)
create object prize (width 1 cell, height 1 cell, speed 0, sprite coin.svg)

-- Rows 13 to 16 are the corridor every chunk leaves open.
create bird bird1 in play (x 1, y 13, xdirection 1)

create prize prize1 in play (x 12, y 14)

create text scoretag in play (x 1, y 1, text "coins:")
create number score in play (value 0, x 8, y 1)

-- A small impulse against a heavy pull: a flap, not a jump. The pull is a
-- per-tick delta, so it is written against `fps` or it is a heavier bird on a
-- console that ticks faster.
when always in play then bird1.ydirection as min(bird1.ydirection + 5.4 / fps, 0.9)

control bird1 a (ydirection -1.2) on press

when bird1 touches pipe, ground then scene as gameover

when bird1 hits screenright then scene as won
when bird1 hits screentop then ydirection as 0

-- Where the reward sits is drawn as the game runs, from
-- the language's own generator rather than the host's.
when prize.right < camera.x in play then (x, y) as (camera.x + screenwidth, random(13, 16))

when bird1 hits prize then (prize1.x, score.value) as (camera.x + screenwidth, score.value + 1)

-- The HUD rides the camera, or it is left behind.
when always in play then (scoretag.x, scoretag.y, score.x, score.y) as (camera.x + 1, camera.y + 1, camera.x + 8, camera.y + 1)

-- endings -------------------------------------

scene gameover

create text lost in gameover (x centerx - 4, y centery, text "clipped it")

when a pressed in gameover then scene as play

scene won

create text finished in won (x centerx - 5, y centery, text "flew it all")

when a pressed in won then scene as play
