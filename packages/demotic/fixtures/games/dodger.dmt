-- Dodger. Many objects at staggered speeds, recycled
-- rather than destroyed.

start title
seed 20260726

-- title ---------------------------------------

scene title

backdrop dodger.title.svg

create text prompt in title (x centerx - 7, y screenheight - 2, text "press a to play")

when a pressed in title then scene as play

-- play ----------------------------------------

scene play

backdrop dodger.play.svg

music descent.mid in play
sound hurt.wav on player hits rock

create object ship (width 1 cell, height 1 cell, speed 65vw, sprite ship.svg)
create object rock (width 1 cell, height 1 cell, sprite rock.svg)

create ship player in play (x centerx, y screenheight - 2)

create rock r1 in play (x 8vw, y 0, speed 22vh, direction south)
create rock r2 in play (x 24vw, y 4, speed 28vh, direction south)
create rock r3 in play (x 40vw, y 8, speed 25vh, direction south)
create rock r4 in play (x 56vw, y 2, speed 31vh, direction south)
create rock r5 in play (x 72vw, y 6, speed 26vh, direction south)
create rock r6 in play (x 88vw, y 10, speed 29vh, direction south)

create text dodgedtag in play (x 1, y 1, text "dodged:")
create number score in play (value 0, x 9, y 1)
create text livestag in play (x 1, y 2, text "lives:")
create number lives in play (value 3, x 8, y 2)

control player left (xdirection -1) on hold
control player right (xdirection 1) on hold

when player hits screenleft, screenright then xdirection as 0

-- Recycling, one line for all six rocks: a level rule
-- naming a class runs once per instance, as its subject.
-- Each new column is drawn within five cells of the
-- ship, so it has to be stepped away from.
when rock.y >= screenheight then (y, x, score.value) as (0, clamp(random(player.centerx - 5, player.centerx + 5), 0, screenwidth - 1), score.value + 1)

when player hits rock then (lives.value, rock.y, rock.x) as (lives.value - 1, 0, clamp(random(player.centerx - 5, player.centerx + 5), 0, screenwidth - 1))

when lives.value reaches 0 in play then scene as gameover
when score.value reaches 30 in play then scene as cleared

-- game over -----------------------------------

scene gameover

create text over in gameover (x centerx - 4, y centery, text "game over")

when a pressed in gameover then scene as play

-- cleared -------------------------------------

scene cleared

create text clear in cleared (x centerx - 6, y centery, text "all dodged")

when a pressed in cleared then scene as play
