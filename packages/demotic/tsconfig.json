{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"],
  // Referenced by file rather than by directory: Playwright's tsconfig loader
  // walks these when a spec imports this package, and it resolves a bare
  // directory to `<dir>.json`. `tsc` accepts either form.
  "references": [
    { "path": "../core/tsconfig.json" },
    { "path": "../audio/tsconfig.json" },
    { "path": "../chip/tsconfig.json" },
    { "path": "../dmg/tsconfig.json" },
    { "path": "../gba/tsconfig.json" },
    { "path": "../md/tsconfig.json" },
    { "path": "../nds/tsconfig.json" },
    { "path": "../nes/tsconfig.json" },
    { "path": "../pce/tsconfig.json" },
    { "path": "../sms/tsconfig.json" },
    { "path": "../snes/tsconfig.json" }
  ]
}
